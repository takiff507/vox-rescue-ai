[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 08/14/2026,1.0.0.0
CatalogFile = VoxRescueVirtualAudio.cat
PnpLockDown = 1

[SourceDisksNames]
222 = %DiskName%,,222

[SourceDisksFiles]
VoxRescueVirtualAudio.sys = 222

[SignatureAttributes]
VoxRescueVirtualAudio.sys = SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel = 1300

[Manufacturer]
%MfgName% = VoxRescue,NT$ARCH$.10.0...19041

[VoxRescue.NT$ARCH$.10.0...19041]
%DeviceDesc% = VoxRescue_Install,Root\VoxRescueVirtualAudio

[DestinationDirs]
VoxRescue.CopyList = 13

[VoxRescue.CopyList]
VoxRescueVirtualAudio.sys

[VoxRescue.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,VoxRescueVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[VoxRescue.I.WaveProcessor]
AddReg = VoxRescue.I.WaveProcessor.AddReg

[VoxRescue.I.WaveProcessor.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveProcessorName%

[VoxRescue.I.TopologyProcessor]
AddReg = VoxRescue.I.TopologyProcessor.AddReg

[VoxRescue.I.TopologyProcessor.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%ProcessorName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[VoxRescue.I.WaveMicrophone]
AddReg = VoxRescue.I.WaveMicrophone.AddReg

[VoxRescue.I.WaveMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveMicrophoneName%

[VoxRescue.I.TopologyMicrophone]
AddReg = VoxRescue.I.TopologyMicrophone.AddReg

[VoxRescue.I.TopologyMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicrophoneName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[VoxRescue_Install.NT]
Include = ks.inf,wdmaudio.inf
Needs = KS.Registration,WDMAUDIO.Registration
CopyFiles = VoxRescue.CopyList
AddReg = VoxRescue.AddReg

[VoxRescue_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveSpeaker%,VoxRescue.I.WaveProcessor
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveSpeaker%,VoxRescue.I.WaveProcessor
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveSpeaker%,VoxRescue.I.WaveProcessor
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,VoxRescue.I.TopologyProcessor
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,VoxRescue.I.TopologyProcessor

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMicIn%,VoxRescue.I.WaveMicrophone
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMicIn%,VoxRescue.I.WaveMicrophone
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveMicIn%,VoxRescue.I.WaveMicrophone
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMicIn%,VoxRescue.I.TopologyMicrophone
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMicIn%,VoxRescue.I.TopologyMicrophone

[VoxRescue_Install.NT.Services]
AddService=VoxRescueVirtualAudio,0x00000002,VoxRescue_Service

[VoxRescue_Service]
DisplayName = %ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\VoxRescueVirtualAudio.sys

[VoxRescue_Install.NT.HW]
AddReg = VoxRescue.Hardware.AddReg

[VoxRescue.Hardware.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[VoxRescue_Install.NT.Wdf]
KmdfService = VoxRescueVirtualAudio,VoxRescue_Wdf

[VoxRescue_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "Vox Rescue AI"
MfgName = "Vox Rescue AI"
DiskName = "Vox Rescue Virtual Audio Driver"
DeviceDesc = "Vox Rescue Virtual Audio"
ServiceDesc = "Vox Rescue Virtual Audio Driver"

ProcessorName = "Vox Rescue Processor"
WaveProcessorName = "Vox Rescue Processor Wave"
MicrophoneName = "Vox Rescue Microphone"
WaveMicrophoneName = "Vox Rescue Microphone Wave"

KSNAME_WaveSpeaker = "WaveSpeaker"
KSNAME_TopologySpeaker = "TopologySpeaker"
KSNAME_WaveMicIn = "WaveMicIn"
KSNAME_TopologyMicIn = "TopologyMicIn"

Proxy.CLSID = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
