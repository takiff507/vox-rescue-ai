<Application
    x:Class="VoxRescueNative.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <controls:XamlControlsResources/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8F8"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F8FFFFFF"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#EEF2F2"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE4E3"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212626"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#697572"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#177C6B"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#18177C6B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#177C6B"/>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#177C6B"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#209885"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#126252"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#177C6B"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#209885"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#126252"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#177C6B"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#209885"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#126252"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#177C6B"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#209885"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#126252"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#177C6B"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#209885"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#126252"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F8FFFFFF"/>
        <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#212626"/>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#DCE4E3"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
      </ResourceDictionary>
    </Application.Resources>
</Application>
